{
  "rules": {
    "matten": {
      ".read": true,
      "$matteId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists() && root.child('admins').child(auth.uid).val().toLowerCase() == root.child('zugang').child('code').val().toLowerCase()",
        "name": { ".validate": "newData.isString() && newData.val().length < 120" },
        "sub": { ".validate": "newData.isString() && newData.val().length < 120" },
        "art": { ".validate": "newData.val() == 'anlage' || newData.val() == 'tribuene'" },
        "status": { ".validate": "newData.val() == 'aufgebaut' || newData.val() == 'abgebaut' || newData.val() == 'eingefahren' || newData.val() == 'ausgefahren'" },
        "aus": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2})?$/)" },
        "ein": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2})?$/)" },
        "reihenfolge": { ".validate": "newData.isNumber()" },
        "geaendert": { ".validate": "newData.isNumber()" },
        "$anderes": { ".validate": false }
      }
    },
    "putzplan": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists() && root.child('admins').child(auth.uid).val().toLowerCase() == root.child('zugang').child('code').val().toLowerCase()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists() && root.child('admins').child(auth.uid).val().toLowerCase() == root.child('zugang').child('code').val().toLowerCase()",
      "lanes": {
        "$lane": {
          "$seg": { ".validate": "newData.isString() && newData.val().length < 16" }
        }
      },
      "notes": {
        "$id": {
          "x": { ".validate": "newData.isNumber()" },
          "y": { ".validate": "newData.isNumber()" },
          "ts": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.isString() && newData.val().length < 400" },
          "by": { ".validate": "newData.isString() && newData.val().length < 30" },
          "d": { ".validate": "newData.isString() && newData.val().length < 30" },
          "$other": { ".validate": false }
        }
      },
      "free": {
        "$id": {
          "p": { ".validate": "newData.isNumber()" },
          "d": { ".validate": "newData.isString() && newData.val().length < 30" },
          "pts": { ".validate": "newData.isString() && newData.val().length < 60000" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },
    "admins": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length >= 6 && newData.val().length <= 60 && newData.val().toLowerCase() == root.child('zugang').child('code').val().toLowerCase()"
      }
    }
  }
}
